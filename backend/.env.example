# Postgres — Database connection example (Replace with your Neon or PostgreSQL credentials)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/neondb?sslmode=require&channel_binding=require"

JWT_SECRET="your_secure_random_jwt_secret_key"
JWT_EXPIRE_MINUTES=10080
ADMIN_DEFAULT_EMAIL="admin@foundation.org"
ADMIN_DEFAULT_PASSWORD="YourStrongPasswordHere"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
